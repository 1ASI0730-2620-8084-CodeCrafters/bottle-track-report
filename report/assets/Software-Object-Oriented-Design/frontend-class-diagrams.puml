@startuml
' BottleTrack - Frontend Web Application (JavaScript / Vue 3)
' Naming conventions applied (JavaScript):
'   - Classes and assemblers: PascalCase
'   - Attributes and methods: camelCase
'   - Enumerations: Object.freeze constants, named in UPPER_SNAKE_CASE as in the code
'   - Private members: prefixed with # (e.g. #http)
'   - / before a name = getter (derived, read-only property)
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam shadowing false
skinparam defaultFontName Arial
skinparam class {
  BackgroundColor #ffffff
  BorderColor #b34900
  ArrowColor #4f2000
}
skinparam package {
  BackgroundColor #fff7ed
  BorderColor #f97316
}
left to right direction

package "Shared Infrastructure" {
  class BaseApi <<Infrastructure>> {
    - #http: AxiosInstance
    + /http: AxiosInstance
  }
  class BaseEndpoint <<Infrastructure>> {
    + http: AxiosInstance
    + endpointPath: string
    + getAll(params): Promise
    + getById(id): Promise
    + create(resource): Promise
    + update(id, resource): Promise
    + partialUpdate(id, resource): Promise
    + delete(id): Promise
  }
  BaseApi "1" ..> "0..*" BaseEndpoint : provides http to
}

package "Identity and Access Management" {
  class Organization <<Entity>> {
    + id: string
    + businessName: string
    + taxId: string
    + email: string
    + phone: string
    + address: string
  }
  class User <<Entity>> {
    + id: string
    + organizationId: string
    + firstName: string
    + lastName: string
    + email: string
    + role: string
    + status: string
    + /fullName: string
    + /initials: string
    + /isActive: boolean
    + hasAnyRole(roles): boolean
  }
  class SignInCommand <<Command>> {
    + email: string
    + password: string
  }
  class SignUpCommand <<Command>> {
    + plan: string
    + businessName: string
    + taxId: string
    + companyEmail: string
    + phone: string
    + address: string
    + firstName: string
    + lastName: string
    + email: string
    + password: string
  }
  enum SUBSCRIPTION_PLANS <<enumeration>> {
    FREE = 'free'
    PREMIUM = 'premium'
  }
  class RegisterUserCommand <<Command>> {
    + organizationId: string
    + firstName: string
    + lastName: string
    + email: string
    + role: string
    + password: string
  }
  class UpdateUserCommand <<Command>> {
    + userId: string
    + firstName: string
    + lastName: string
    + email: string
  }
  class AssignRoleCommand <<Command>> {
    + userId: string
    + role: string
  }
  class UpdateOrganizationCommand <<Command>> {
    + organizationId: string
    + businessName: string
    + phone: string
    + address: string
  }
  enum USER_ROLES <<enumeration>> {
    ADMINISTRATOR = 'administrator'
    FLEET_SUPERVISOR = 'fleet_supervisor'
    DELIVERY_POINT_OWNER = 'delivery_point_owner'
  }
  class SignInResource <<Resource>> {
    + user: Object
    + token: string
  }
  class IamApi <<Infrastructure>> {
    - #usersEndpoint: BaseEndpoint
    - #organizationsEndpoint: BaseEndpoint
    + signIn(signInCommand): Promise
    + getUsersByOrganization(organizationId): Promise
    + createUser(userResource): Promise
    + updateUser(userId, userResource): Promise
    + assignRole(userId, role): Promise
    + createOrganization(organizationResource): Promise
    + getOrganizationById(organizationId): Promise
    + updateOrganization(organizationId, organizationResource): Promise
  }
  class UserAssembler <<Assembler>> {
    + {static} toEntityFromResource(resource): User
    + {static} toResourceFromEntity(user): Object
    + {static} toEntitiesFromResponse(response): User[]
    + {static} toResourceFromRegisterCommand(command): Object
    + {static} toResourceFromUpdateCommand(command): Object
  }
  class OrganizationAssembler <<Assembler>> {
    + {static} toEntityFromResource(resource): Organization
    + {static} toResourceFromSignUpCommand(command): Object
    + {static} toResourceFromUpdateCommand(command): Object
  }
  class SignInAssembler <<Assembler>> {
    + {static} toResourceFromResponse(response): SignInResource
  }
  User "1" --> "1" USER_ROLES : has role
  AssignRoleCommand "0..*" --> "1" User : assigns a role to
  AssignRoleCommand "1" --> "1" USER_ROLES : carries the new role
  UserAssembler "1" ..> "0..*" User : creates
  UserAssembler "1" ..> "0..*" RegisterUserCommand : reads
  UserAssembler "1" ..> "0..*" UpdateUserCommand : reads
  OrganizationAssembler "1" ..> "0..*" Organization : creates
  OrganizationAssembler "1" ..> "0..*" UpdateOrganizationCommand : reads
  OrganizationAssembler "1" ..> "0..*" SignUpCommand : reads
  SignUpCommand "1" --> "1" SUBSCRIPTION_PLANS : selects plan
  SignInAssembler "1" ..> "0..*" SignInResource : creates
  IamApi "1" ..> "0..*" SignInCommand : receives
  IamApi "1" *-- "2" BaseEndpoint : owns
  IamApi --|> BaseApi
}

package "Fleet Management" {
  class Vehicle <<Entity>> {
    + id: string
    + organizationId: string
    + plateNumber: string
    + brand: string
    + model: string
    + capacityInBoxes: number
    + status: string
    + /description: string
    + /isAvailable: boolean
  }
  class Driver <<Entity>> {
    + id: string
    + organizationId: string
    + firstName: string
    + lastName: string
    + documentNumber: string
    + licenseNumber: string
    + phone: string
    + status: string
    + /fullName: string
    + /isAvailable: boolean
  }
  enum VEHICLE_STATUSES <<enumeration>> {
    AVAILABLE = 'available'
    ASSIGNED = 'assigned'
    IN_MAINTENANCE = 'in_maintenance'
  }
  enum DRIVER_STATUSES <<enumeration>> {
    AVAILABLE = 'available'
    ASSIGNED = 'assigned'
    INACTIVE = 'inactive'
  }
  class FleetApi <<Infrastructure>> {
    - #vehiclesEndpoint: BaseEndpoint
    - #driversEndpoint: BaseEndpoint
    + getVehicles(organizationId): Promise
    + createVehicle(vehicleResource): Promise
    + updateVehicle(vehicleId, vehicleResource): Promise
    + getDrivers(organizationId): Promise
    + createDriver(driverResource): Promise
    + updateDriver(driverId, driverResource): Promise
  }
  class VehicleAssembler <<Assembler>> {
    + {static} toEntityFromResource(resource): Vehicle
    + {static} toEntitiesFromResponse(response): Vehicle[]
    + {static} toResourceFromEntity(vehicle): Object
  }
  class DriverAssembler <<Assembler>> {
    + {static} toEntityFromResource(resource): Driver
    + {static} toEntitiesFromResponse(response): Driver[]
    + {static} toResourceFromEntity(driver): Object
  }
  Vehicle "1" --> "1" VEHICLE_STATUSES : has status
  Driver "1" --> "1" DRIVER_STATUSES : has status
  VehicleAssembler "1" ..> "0..*" Vehicle : creates
  DriverAssembler "1" ..> "0..*" Driver : creates
  FleetApi "1" *-- "2" BaseEndpoint : owns
  FleetApi --|> BaseApi
}

package "Operations and Routes" {
  class TransportOperation <<Entity>> {
    + id: string
    + organizationId: string
    + code: string
    + description: string
    + scheduledDate: string
    + vehicleId: string
    + driverId: string
    + status: string
    + dispatchedAt: string
    + completedAt: string
    + cancellationReason: string
    + stops: DeliveryStop[]
    + vehiclePlateNumber: string
    + vehicleLabel: string
    + driverName: string
    + /isPending: boolean
    + /isInProgress: boolean
    + /hasResources: boolean
    + /canCancel: boolean
    + /isFinished: boolean
    + /canStart: boolean
    + /pendingStopsCount: number
    + /canComplete: boolean
    + /nextSequenceNumber: number
    + /progress: Object
    + /registeredStopsCount: number
  }
  class DeliveryStop <<Entity>> {
    + id: string
    + transportOperationId: string
    + deliveryPointId: string
    + deliveryPointName: string
    + deliveryPointAddress: string
    + deliveryPointDistrict: string
    + latitude: number
    + longitude: number
    + sequenceNumber: number
    + plannedQuantity: number
    + deliveredQuantity: number
    + status: string
    + failureReason: string
    + confirmedAt: string
    + /isPending: boolean
    + /hasLocation: boolean
  }
  class DeliveryOrder <<Entity>> {
    + id: string
    + transportOperationId: string
    + operationCode: string
    + operationStatus: string
    + scheduledDate: string
    + deliveryPointName: string
    + sequenceNumber: number
    + plannedQuantity: number
    + deliveredQuantity: number
    + status: string
    + failureReason: string
    + confirmedAt: string
    + pendingStopsBefore: number
    + hasReportedProblem: boolean
    + /isRegistered: boolean
    + /isOnRoute: boolean
    + /trackingStatus: string
    + /shortage: number
    + /canReportProblem: boolean
  }
  class CreateOperationCommand <<Command>> {
    + organizationId: string
    + description: string
    + scheduledDate: string
  }
  class AddDeliveryStopCommand <<Command>> {
    + operation: TransportOperation
    + deliveryPointId: string
    + plannedQuantity: number
  }
  class RecordDeliveryCommand <<Command>> {
    + stop: DeliveryStop
    + status: string
    + deliveredQuantity: number
    + failureReason: string
    + resolveDeliveredQuantity(status, deliveredQuantity, plannedQuantity): number
    + /isValid: boolean
  }
  class ReportReceptionProblemCommand <<Command>> {
    + deliveryOrder: DeliveryOrder
    + reportedBy: string
    + type: string
    + affectedQuantity: number
    + description: string
    + /isValid: boolean
  }
  enum OPERATION_STATUSES <<enumeration>> {
    PENDING = 'pending'
    DISPATCHED = 'dispatched'
    IN_PROGRESS = 'in_progress'
    COMPLETED = 'completed'
    CANCELLED = 'cancelled'
  }
  enum DELIVERY_STATUSES <<enumeration>> {
    PENDING = 'pending'
    DELIVERED = 'delivered'
    PARTIALLY_DELIVERED = 'partially_delivered'
    NOT_DELIVERED = 'not_delivered'
  }
  enum RECEPTION_PROBLEM_TYPES <<enumeration>> {
    shortage
    damaged_product
    broken_bottles
  }
  class TransportOperationsApi <<Infrastructure>> {
    - #operationsEndpoint: BaseEndpoint
    - #deliveryPointsEndpoint: BaseEndpoint
    - #vehiclesEndpoint: BaseEndpoint
    - #driversEndpoint: BaseEndpoint
    + getOperations(organizationId): Promise
    + getOperationById(operationId): Promise
    + createOperation(operationResource): Promise
    + addStop(operationId, stopResource): Promise
    + getDeliveryPoints(organizationId): Promise
    + getVehicles(organizationId): Promise
    + getDrivers(organizationId): Promise
  }
  class OperationsApi <<Infrastructure>> {
    - #deliveryPointsEndpoint: BaseEndpoint
    - #transportOperationsEndpoint: BaseEndpoint
    - #deliveryStopsEndpoint: BaseEndpoint
    - #incidentsEndpoint: BaseEndpoint
    + getDeliveryPointsByOwner(ownerUserId): Promise
    + getDeliveryStopsByDeliveryPoints(deliveryPointIds): Promise
    + getDeliveryStopsByOperations(transportOperationIds): Promise
    + getTransportOperationsByIds(transportOperationIds): Promise
    + getIncidentsByDeliveryStops(deliveryStopIds): Promise
    + getLatestIncident(): Promise
    + createIncident(incidentResource): Promise
  }
  class TransportOperationAssembler <<Assembler>> {
    + {static} toStopEntity(resource, deliveryPoints): DeliveryStop
    + {static} toEntityFromResource(resource, references): TransportOperation
    + {static} toEntitiesFromResources(resources, references): TransportOperation[]
    + {static} toResourceFromCreateCommand(command, code): Object
    + {static} toStopResourceFromCommand(command): Object
    + {static} nextCode(operations): string
  }
  class DeliveryOrderAssembler <<Assembler>> {
    + {static} toEntityFromResources(resources): DeliveryOrder
    + {static} toEntitiesFromResources(resources): DeliveryOrder[]
  }
  class "IncidentAssembler" as OperationsIncidentAssembler <<Assembler>> {
    + {static} nextCode(latestIncident): string
    + {static} toResourceFromCommand(command, code): Object
  }
  TransportOperation "1" *-- "0..*" DeliveryStop : contains
  TransportOperation "1" --> "1" OPERATION_STATUSES : has status
  DeliveryStop "1" --> "1" DELIVERY_STATUSES : has status
  DeliveryOrder "1" --> "1" DELIVERY_STATUSES : has status
  DeliveryOrder "1" --> "1" OPERATION_STATUSES : has operation status
  RecordDeliveryCommand "1" --> "1" DELIVERY_STATUSES : records status
  ReportReceptionProblemCommand "1" --> "1" RECEPTION_PROBLEM_TYPES : has type
  AddDeliveryStopCommand "0..*" --> "1" TransportOperation : adds a stop to
  RecordDeliveryCommand "0..*" --> "1" DeliveryStop : records the result of
  ReportReceptionProblemCommand "0..*" --> "1" DeliveryOrder : reports a problem on
  TransportOperationAssembler "1" ..> "0..*" TransportOperation : creates
  TransportOperationAssembler "1" ..> "0..*" DeliveryStop : creates
  TransportOperationAssembler "1" ..> "0..*" CreateOperationCommand : reads
  TransportOperationAssembler "1" ..> "0..*" AddDeliveryStopCommand : reads
  DeliveryOrderAssembler "1" ..> "0..*" DeliveryOrder : creates
  OperationsIncidentAssembler "1" ..> "0..*" ReportReceptionProblemCommand : reads
  TransportOperationsApi "1" *-- "4" BaseEndpoint : owns
  OperationsApi "1" *-- "4" BaseEndpoint : owns
  TransportOperationsApi --|> BaseApi
  OperationsApi --|> BaseApi
}

package "IoT Monitoring" {
  class IoTDevice <<Entity>> {
    + id: string
    + serialNumber: string
    + vehicleId: string
    + vehiclePlateNumber: string
    + safeTemperatureMin: number
    + safeTemperatureMax: number
    + impactThreshold: number
    + status: string
    + isTemperatureSafe(temperatureCelsius): boolean
    + isImpactSafe(impactForce): boolean
    + evaluate(reading): string[]
  }
  class SensorReading <<Entity>> {
    + id: string
    + iotDeviceId: string
    + transportOperationId: string
    + recordedAt: string
    + latitude: number
    + longitude: number
    + temperatureCelsius: number
    + impactForce: number
  }
  class Alert <<Entity>> {
    + id: string
    + iotDeviceId: string
    + transportOperationId: string
    + type: string
    + raisedAt: string
    + acknowledgedBy: string
    + acknowledgedAt: string
    + operationCode: string
    + /isAcknowledged: boolean
    + /incidentType: string
  }
  class SafeRange <<Value Object>> {
    + safeTemperatureMin: number
    + safeTemperatureMax: number
    + impactThreshold: number
    + /validationError: string
  }
  class MonitoredOperation <<Read Model>> {
    + operationId: string
    + operationCode: string
    + description: string
    + vehiclePlateNumber: string
    + device: IoTDevice
    + latestReading: SensorReading
    + /hasDevice: boolean
    + /isCargoSafe: boolean
    + isOffline(now): boolean
  }
  enum ALERT_TYPES <<enumeration>> {
    TEMPERATURE_OUT_OF_RANGE = 'temperature_out_of_range'
    IMPACT_DETECTED = 'impact_detected'
    DEVICE_OFFLINE = 'device_offline'
  }
  class MonitoringApi <<Infrastructure>> {
    - #vehiclesEndpoint: BaseEndpoint
    - #devicesEndpoint: BaseEndpoint
    + getVehicles(organizationId): Promise
    + getAllDevices(): Promise
  }
  class MonitoringAssembler <<Assembler>> {
    + {static} toMonitoredOperation(operation, references): MonitoredOperation
    + {static} toDevice(resource, vehicles): IoTDevice
    + {static} toAlert(resource, operations): Alert
    + {static} toIncidentResourceFromAlert(alert, context): Object
    + {static} toSimulatedReadingResource(monitoredOperation): Object
    + {static} toAlertResource(reading, type): Object
  }
  MonitoredOperation "1" --> "0..1" IoTDevice : is monitored by
  MonitoredOperation "1" --> "0..1" SensorReading : has latest reading
  IoTDevice "1" ..> "0..*" SensorReading : evaluates
  IoTDevice "1" ..> "0..2" ALERT_TYPES : returns
  Alert "1" --> "1" ALERT_TYPES : is of type
  SafeRange "0..*" ..> "1" IoTDevice : sets the limits of
  MonitoringAssembler "1" ..> "0..*" MonitoredOperation : creates
  MonitoringAssembler "1" ..> "0..*" IoTDevice : creates
  MonitoringAssembler "1" ..> "0..*" Alert : creates
  MonitoringAssembler "1" ..> "0..*" SensorReading : creates
  MonitoringApi "1" *-- "2" BaseEndpoint : owns
  MonitoringApi --|> BaseApi
}

package "Incident Management" {
  class Incident <<Entity>> {
    + id: string
    + code: string
    + transportOperationId: string
    + deliveryStopId: string
    + reportedBy: string
    + source: string
    + type: string
    + severity: string
    + description: string
    + affectedQuantity: number
    + status: string
    + resolution: string
    + reportedAt: string
    + resolvedAt: string
    + operationCode: string
    + /nextStatus: string
    + /isOpen: boolean
    + /requiresResolution: boolean
  }
  class Evidence <<Entity>> {
    + id: string
    + incidentId: string
    + fileUrl: string
    + fileType: string
    + uploadedAt: string
    + uploadedBy: string
  }
  class ReportIncidentCommand <<Command>> {
    + transportOperationId: string
    + reportedBy: string
    + type: string
    + severity: string
    + description: string
    + affectedQuantity: number
    + /isValid: boolean
  }
  class AdvanceIncidentCommand <<Command>> {
    + incident: Incident
    + nextStatus: string
    + resolution: string
    + /isValid: boolean
  }
  class AttachEvidenceCommand <<Command>> {
    + incidentId: string
    + fileUrl: string
    + uploadedBy: string
    + /isValid: boolean
  }
  enum INCIDENT_STATUSES <<enumeration>> {
    REPORTED = 'reported'
    UNDER_REVIEW = 'under_review'
    RESOLVED = 'resolved'
    CLOSED = 'closed'
  }
  enum INCIDENT_TYPES <<enumeration>> {
    broken_bottles
    damaged_product
    shortage
    delay
  }
  enum INCIDENT_SEVERITIES <<enumeration>> {
    low
    medium
    high
    critical
  }
  class IncidentsApi <<Infrastructure>> {
    - #incidentsEndpoint: BaseEndpoint
    - #operationsEndpoint: BaseEndpoint
    + getOperations(organizationId): Promise
    + getIncidentsByOperation(transportOperationId): Promise
    + getIncidentById(incidentId): Promise
    + createIncident(incidentResource): Promise
    + addEvidence(incidentId, evidenceResource): Promise
    + resolveIncident(incidentId, resolution): Promise
  }
  class IncidentAssembler <<Assembler>> {
    + {static} toEntityFromResource(resource, operations): Incident
    + {static} toEntitiesFromResources(resources, operations): Incident[]
    + {static} nextCode(incidents): string
    + {static} toResourceFromReportCommand(command, code): Object
    + {static} toChangesFromAdvanceCommand(command): Object
  }
  class EvidenceAssembler <<Assembler>> {
    + {static} toEntityFromResource(resource): Evidence
    + {static} toEntitiesFromResources(resources): Evidence[]
    + {static} toResourceFromCommand(command): Object
  }
  Evidence "0..*" --> "1" Incident : belongs to
  Incident "1" --> "1" INCIDENT_STATUSES : has status
  Incident "1" --> "1" INCIDENT_TYPES : is classified as
  Incident "1" --> "1" INCIDENT_SEVERITIES : has severity
  ReportIncidentCommand "1" --> "1" INCIDENT_TYPES : has type
  ReportIncidentCommand "1" --> "1" INCIDENT_SEVERITIES : has severity
  AdvanceIncidentCommand "0..*" --> "1" Incident : advances
  AttachEvidenceCommand "0..*" --> "1" Incident : attaches evidence to
  IncidentAssembler "1" ..> "0..*" Incident : creates
  IncidentAssembler "1" ..> "0..*" ReportIncidentCommand : reads
  IncidentAssembler "1" ..> "0..*" AdvanceIncidentCommand : reads
  EvidenceAssembler "1" ..> "0..*" Evidence : creates
  EvidenceAssembler "1" ..> "0..*" AttachEvidenceCommand : reads
  IncidentsApi "1" *-- "2" BaseEndpoint : owns
  IncidentsApi --|> BaseApi
}

TransportOperation "0..*" ..> "0..1" Vehicle : uses (vehicleId)
TransportOperation "0..*" ..> "0..1" Driver : uses (driverId)
Incident "0..*" ..> "1" TransportOperation : is reported on (transportOperationId)
Alert "0..*" ..> "1" TransportOperation : is raised on (transportOperationId)
MonitoredOperation "1" ..> "1" TransportOperation : monitors (operationId)
IoTDevice "0..1" ..> "1" Vehicle : is installed on (vehicleId)
@enduml
