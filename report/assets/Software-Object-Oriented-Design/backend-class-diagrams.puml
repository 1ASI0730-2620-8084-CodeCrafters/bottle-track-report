@startuml
' BottleTrack - Backend (C# / ASP.NET Core) - Domain model per bounded context
' All packages reflect the code of the Web Services repository.
' Naming conventions applied (C#):
'   - Classes, enumerations and enumeration members: PascalCase
'   - Properties: public, PascalCase (shown with +)
'   - Methods: PascalCase; method parameters: camelCase
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam shadowing false
skinparam defaultFontName Arial
skinparam class {
  BackgroundColor #ffffff
  BorderColor #b34900
  ArrowColor #4f2000
}
skinparam package {
  BackgroundColor #fff7ed
  BorderColor #f97316
}
left to right direction

package "Shared Kernel" {
  interface "IBaseRepository<TEntity>" as IBaseRepository {
    + AddAsync(entity: TEntity): Task
    + FindByIdAsync(id: Guid): Task<TEntity?>
    + ListAsync(): Task<IEnumerable<TEntity>>
    + Update(entity: TEntity): void
    + Remove(entity: TEntity): void
  }
  interface IUnitOfWork {
    + CompleteAsync(): Task
  }
  class "Result<TValue, TError>" as Result {
    + IsSuccess: bool
    + IsFailure: bool
    + Value: TValue
    + Error: TError
    + Success(value: TValue): Result
    + Failure(error: TError): Result
    + Fold(onSuccess, onFailure): TResult
  }
  interface IAuditableEntity {
    + CreatedAt: DateTimeOffset?
    + UpdatedAt: DateTimeOffset?
  }
}

package "Identity and Access Management" {
  class Organization <<Aggregate Root>> {
    + Id: Guid
    + BusinessName: string
    + TaxId: TaxId
    + Email: EmailAddress
    + Phone: string
    + Address: string
    + {static} Register(businessName, taxId, email): Organization
    + UpdateProfile(businessName, phone, address): void
  }
  class User <<Aggregate Root>> {
    + Id: Guid
    + OrganizationId: Guid
    + FirstName: string
    + LastName: string
    + Email: EmailAddress
    + PasswordHash: string
    + Role: UserRole
    + Status: UserStatus
    + {static} Register(organizationId, firstName, lastName, email, passwordHash, role): User
    + AssignRole(role: UserRole): void
    + Deactivate(): void
    + UpdateProfile(firstName, lastName, email): void
  }
  class EmailAddress <<Value Object>> {
    + Value: string
  }
  class TaxId <<Value Object>> {
    + Value: string
  }
  enum UserRole {
    Administrator
    FleetSupervisor
    DeliveryPointOwner
  }
  enum UserStatus {
    Active
    Inactive
  }
  interface IOrganizationRepository {
    + FindByTaxIdAsync(taxId: TaxId): Task<Organization?>
  }
  interface IUserRepository {
    + FindByEmailAsync(email: EmailAddress): Task<User?>
    + ListByOrganizationAsync(organizationId: Guid): Task<IEnumerable<User>>
  }
  User "1..*" --> "1" Organization : belongs to (OrganizationId)
  User "1" --> "1" UserRole : has role
  User "1" --> "1" UserStatus : has status
  User "1" *-- "1" EmailAddress : is identified by
  Organization "1" *-- "1" EmailAddress : is contacted at
  Organization "1" *-- "1" TaxId : is registered with
  IOrganizationRepository --|> IBaseRepository
  IUserRepository --|> IBaseRepository
  IOrganizationRepository "1" ..> "0..*" Organization : persists
  IUserRepository "1" ..> "0..*" User : persists
}

package "Fleet Management" {
  class Vehicle <<Aggregate Root>> {
    + Id: Guid
    + OrganizationId: Guid
    + PlateNumber: PlateNumber
    + Brand: string
    + Model: string
    + CapacityInBoxes: int
    + Status: VehicleStatus
    + {static} Register(organizationId, plateNumber, brand, model, capacityInBoxes): Vehicle
    + Reserve(): void
    + Release(): void
    + SendToMaintenance(): void
    + UpdateDetails(brand, model, capacityInBoxes): void
  }
  class Driver <<Aggregate Root>> {
    + Id: Guid
    + OrganizationId: Guid
    + FirstName: string
    + LastName: string
    + DocumentNumber: string
    + LicenseNumber: LicenseNumber
    + Phone: string
    + Status: DriverStatus
    + {static} Register(organizationId, firstName, lastName, documentNumber, licenseNumber, phone): Driver
    + Reserve(): void
    + Release(): void
    + UpdateDetails(firstName, lastName, phone): void
  }
  class PlateNumber <<Value Object>> {
    + Value: string
  }
  class LicenseNumber <<Value Object>> {
    + Value: string
  }
  enum VehicleStatus {
    Available
    Assigned
    InMaintenance
  }
  enum DriverStatus {
    Available
    Assigned
    Inactive
  }
  interface IVehicleRepository {
    + FindByPlateNumberAsync(plateNumber: PlateNumber): Task<Vehicle?>
    + ListByOrganizationAsync(organizationId: Guid): Task<IEnumerable<Vehicle>>
    + ListAvailableAsync(organizationId: Guid): Task<IEnumerable<Vehicle>>
  }
  interface IDriverRepository {
    + FindByDocumentNumberAsync(documentNumber: string): Task<Driver?>
    + FindByLicenseNumberAsync(licenseNumber: LicenseNumber): Task<Driver?>
    + ListByOrganizationAsync(organizationId: Guid): Task<IEnumerable<Driver>>
    + ListAvailableAsync(organizationId: Guid): Task<IEnumerable<Driver>>
  }
  Vehicle "1" *-- "1" PlateNumber : is identified by
  Vehicle "1" --> "1" VehicleStatus : has status
  Driver "1" *-- "1" LicenseNumber : is licensed with
  Driver "1" --> "1" DriverStatus : has status
  IVehicleRepository --|> IBaseRepository
  IDriverRepository --|> IBaseRepository
  IVehicleRepository "1" ..> "0..*" Vehicle : persists
  IDriverRepository "1" ..> "0..*" Driver : persists
}

package "Operations and Routes" {
  class TransportOperation <<Aggregate Root>> {
    + Id: Guid
    + OrganizationId: Guid
    + Code: string
    + Description: string
    + ScheduledDate: DateOnly
    + VehicleId: Guid?
    + DriverId: Guid?
    + Status: TransportOperationStatus
    + DispatchedAt: DateTime?
    + CompletedAt: DateTime?
    + CancellationReason: string?
    + Create(code, organizationId, description, scheduledDate): TransportOperation
    + AddStop(deliveryPointId, sequenceNumber, plannedQuantity): void
    + Dispatch(vehicleId, driverId): void
    + Complete(): void
    + Cancel(reason): void
  }
  class DeliveryStop <<Entity>> {
    + Id: Guid
    + TransportOperationId: Guid
    + DeliveryPointId: Guid
    + SequenceNumber: int
    + PlannedQuantity: int
    + DeliveredQuantity: int?
    + Status: DeliveryStopStatus
    + FailureReason: string?
    + ConfirmedAt: DateTime?
    + Create(transportOperationId, deliveryPointId, sequenceNumber, plannedQuantity): DeliveryStop
  }
  class DeliveryPoint <<Aggregate Root>> {
    + Id: Guid
    + OrganizationId: Guid
    + OwnerUserId: Guid?
    + BusinessName: string
    + Address: string
    + District: string
    + Latitude: decimal?
    + Longitude: decimal?
    + Register(organizationId, ownerUserId, businessName, address, district, latitude, longitude): DeliveryPoint
  }
  enum TransportOperationStatus {
    Pending
    Dispatched
    InProgress
    Completed
    Cancelled
  }
  enum DeliveryStopStatus {
    Pending
    Delivered
    PartiallyDelivered
    NotDelivered
  }
  interface ITransportOperationRepository {
    + FindByIdWithStopsAsync(id: Guid): Task<TransportOperation>
    + ListByOrganizationAsync(organizationId: Guid): Task<IEnumerable<TransportOperation>>
    + CountAsync(): Task<int>
  }
  interface IDeliveryPointRepository {
    + ListByOrganizationAsync(organizationId: Guid): Task<IEnumerable<DeliveryPoint>>
  }
  TransportOperation "1" *-- "0..*" DeliveryStop : contains
  TransportOperation "1" --> "1" TransportOperationStatus : has status
  DeliveryStop "1" --> "1" DeliveryStopStatus : has status
  DeliveryStop "0..*" --> "1" DeliveryPoint : is delivered at
  ITransportOperationRepository --|> IBaseRepository
  IDeliveryPointRepository --|> IBaseRepository
  ITransportOperationRepository "1" ..> "0..*" TransportOperation : persists
  IDeliveryPointRepository "1" ..> "0..*" DeliveryPoint : persists
}

package "IoT Monitoring" {
  class IotDevice <<Aggregate Root>> {
    + Id: Guid
    + SerialNumber: string
    + VehicleId: Guid?
    + SafeTemperatureMin: decimal
    + SafeTemperatureMax: decimal
    + ImpactThreshold: decimal
    + Status: DeviceStatus
    + Register(serialNumber, vehicleId, safeTemperatureMin, safeTemperatureMax, impactThreshold): IotDevice
    + GoOffline(): void
    + Retire(): void
  }
  class SensorReading <<Aggregate Root>> {
    + Id: Guid
    + IotDeviceId: Guid
    + TransportOperationId: Guid?
    + RecordedAt: DateTime
    + Latitude: decimal?
    + Longitude: decimal?
    + TemperatureCelsius: decimal?
    + ImpactForce: decimal?
    + Record(iotDeviceId, transportOperationId, recordedAt, latitude, longitude, temperatureCelsius, impactForce): SensorReading
  }
  class Alert <<Aggregate Root>> {
    + Id: Guid
    + IotDeviceId: Guid
    + TransportOperationId: Guid
    + Type: AlertType
    + RaisedAt: DateTime
    + AcknowledgedBy: Guid?
    + AcknowledgedAt: DateTime?
    + Raise(iotDeviceId, transportOperationId, type): Alert
    + Acknowledge(userId): void
  }
  enum AlertType {
    TemperatureOutOfRange
    ImpactDetected
    DeviceOffline
  }
  enum DeviceStatus {
    Active
    Offline
    Retired
  }
  interface IIotDeviceRepository {
    + FindBySerialNumberAsync(serialNumber: string): Task<IotDevice>
  }
  interface ISensorReadingRepository {
    + ListByDeviceAsync(iotDeviceId: Guid): Task<IEnumerable<SensorReading>>
  }
  interface IAlertRepository {
    + ListByDeviceAsync(iotDeviceId: Guid): Task<IEnumerable<Alert>>
  }
  IotDevice "1" --> "0..*" SensorReading : records
  IotDevice "1" --> "0..*" Alert : raises
  Alert "1" --> "1" AlertType : is of type
  IotDevice "1" --> "1" DeviceStatus : has status
  IIotDeviceRepository --|> IBaseRepository
  ISensorReadingRepository --|> IBaseRepository
  IAlertRepository --|> IBaseRepository
  IIotDeviceRepository "1" ..> "0..*" IotDevice : persists
  ISensorReadingRepository "1" ..> "0..*" SensorReading : persists
  IAlertRepository "1" ..> "0..*" Alert : persists
}

package "Incident Management" {
  class Incident <<Aggregate Root>> {
    + Id: Guid
    + Code: string
    + TransportOperationId: Guid
    + DeliveryStopId: Guid?
    + ReportedBy: Guid
    + Source: IncidentSource
    + Type: IncidentType
    + Severity: IncidentSeverity
    + Description: string
    + AffectedQuantity: int?
    + Status: IncidentStatus
    + Resolution: string?
    + ReportedAt: DateTime
    + ResolvedAt: DateTime?
    + Report(code, transportOperationId, deliveryStopId, reportedBy, source, type, severity, description, affectedQuantity): Incident
    + AddEvidence(fileUrl, fileType, uploadedBy): void
    + StartReview(): void
    + Resolve(resolution): void
    + Close(): void
  }
  class Evidence <<Entity>> {
    + Id: Guid
    + IncidentId: Guid
    + FileUrl: string
    + FileType: string
    + UploadedBy: Guid
    + UploadedAt: DateTime
    + Create(incidentId, fileUrl, fileType, uploadedBy): Evidence
  }
  enum IncidentType {
    BrokenBottles
    DamagedProduct
    Shortage
    Delay
  }
  enum IncidentSeverity {
    Low
    Medium
    High
    Critical
  }
  enum IncidentStatus {
    Reported
    UnderReview
    Resolved
    Closed
  }
  enum IncidentSource {
    FleetSupervisor
    DeliveryPoint
    IotAlert
  }
  interface IIncidentRepository {
    + FindByIdWithEvidencesAsync(id: Guid): Task<Incident>
    + ListByTransportOperationAsync(transportOperationId: Guid): Task<IEnumerable<Incident>>
    + CountAsync(): Task<int>
  }
  Incident "1" *-- "0..*" Evidence : is supported by
  Incident "1" --> "1" IncidentType : is classified as
  Incident "1" --> "1" IncidentSeverity : has severity
  Incident "1" --> "1" IncidentStatus : has status
  Incident "1" --> "1" IncidentSource : originates from
  IIncidentRepository --|> IBaseRepository
  IIncidentRepository "1" ..> "0..*" Incident : persists
}

TransportOperation "0..*" ..> "0..1" Vehicle : uses (VehicleId)
TransportOperation "0..*" ..> "0..1" Driver : uses (DriverId)
Incident "0..*" ..> "1" TransportOperation : is reported on (TransportOperationId)
Alert "0..*" ..> "1" TransportOperation : is raised on (TransportOperationId)
IotDevice "0..1" ..> "1" Vehicle : is installed on (VehicleId)
@enduml
