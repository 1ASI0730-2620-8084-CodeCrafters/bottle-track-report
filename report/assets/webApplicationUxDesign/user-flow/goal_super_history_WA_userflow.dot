digraph G {
  graph [rankdir=TB, bgcolor="white", fontname="Inter", nodesep=0.45, ranksep=0.55, pad=0.3, newrank=true];
  node [fontname="Inter", fontsize=12, color="#78716c"];
  edge [fontname="Inter", fontsize=11, arrowsize=0.8];
  start [shape=circle, style=filled, fillcolor="#1f2937", fontcolor="white", label="Inicio", width=0.8, fixedsize=true];
  dash [shape=plain, label=<<TABLE BORDER="2" COLOR="#f97316" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD FIXEDSIZE="TRUE" WIDTH="224" HEIGHT="140"><IMG SRC="screens/supervisor-dashboard.png" SCALE="TRUE"/></TD></TR><TR><TD BGCOLOR="#fff7ed"><B>Dashboard del supervisor</B></TD></TR></TABLE>>];
  a1 [shape=box, style="rounded,filled", fillcolor="#f5f5f4", color="#a8a29e", label=<Selecciona «Historial»<BR/>en el menú>];
  hist [shape=plain, label=<<TABLE BORDER="2" COLOR="#f97316" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD FIXEDSIZE="TRUE" WIDTH="224" HEIGHT="140"><IMG SRC="screens/operation-history.png" SCALE="TRUE"/></TD></TR><TR><TD BGCOLOR="#fff7ed"><B>Historial de operaciones</B></TD></TR></TABLE>>];
  a2 [shape=box, style="rounded,filled", fillcolor="#f5f5f4", color="#a8a29e", label=<Filtra por rango de<BR/>fechas, conductor o<BR/>estado>];
  d1 [shape=diamond, style=filled, fillcolor="#fef3c7", color="#d97706", penwidth=1.5, margin="0.02,0.02", label=<¿Hay operaciones<BR/>con esos filtros?>];
  e1 [shape=box, style="rounded,filled", fillcolor="#fee2e2", color="#dc2626", penwidth=1.5, label=<<B>Unhappy path</B><BR/>La tabla indica que no hay<BR/>resultados>];
  d2 [shape=diamond, style=filled, fillcolor="#fef3c7", color="#d97706", penwidth=1.5, margin="0.02,0.02", label=<¿Qué necesita?>];
  detail [shape=plain, label=<<TABLE BORDER="2" COLOR="#f97316" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD FIXEDSIZE="TRUE" WIDTH="224" HEIGHT="140"><IMG SRC="screens/operation-history-detail.png" SCALE="TRUE"/></TD></TR><TR><TD BGCOLOR="#fff7ed"><B>Detalle en modo lectura</B></TD></TR></TABLE>>];
  end1 [shape=box, style="rounded,filled,bold", fillcolor="#dcfce7", color="#15803d", penwidth=2, label=<<B>Fin</B><BR/>Revisa entregas,<BR/>incidencias y merma sin<BR/>poder editar>];
  end2 [shape=box, style="rounded,filled,bold", fillcolor="#dcfce7", color="#15803d", penwidth=2, label=<<B>Fin</B><BR/>Descarga el historial<BR/>filtrado con «Exportar»>];
  start -> dash [color="#15803d", fontcolor="#15803d", penwidth=2.2];
  dash -> a1 [color="#15803d", fontcolor="#15803d", penwidth=2.2];
  a1 -> hist [color="#15803d", fontcolor="#15803d", penwidth=2.2];
  hist -> a2 [color="#15803d", fontcolor="#15803d", penwidth=2.2];
  a2 -> d1 [color="#15803d", fontcolor="#15803d", penwidth=2.2];
  d1 -> d2 [color="#15803d", fontcolor="#15803d", penwidth=2.2, label=<<B>Sí</B>>];
  d1 -> e1 [color="#dc2626", fontcolor="#dc2626", style=dashed, penwidth=1.6, label=<<B>No</B>>];
  e1 -> hist [color="#dc2626", fontcolor="#dc2626", style=dashed, penwidth=1.6, label=<<B>Cambia los filtros</B>>, constraint=false];
  d2 -> detail [color="#15803d", fontcolor="#15803d", penwidth=2.2, label=<<B>Ver detalle</B>>];
  detail -> end1 [color="#15803d", fontcolor="#15803d", penwidth=2.2];
  d2 -> end2 [color="#15803d", fontcolor="#15803d", penwidth=2.2, label=<<B>Exportar</B>>];
  { rank=same; d1; e1; }
}
