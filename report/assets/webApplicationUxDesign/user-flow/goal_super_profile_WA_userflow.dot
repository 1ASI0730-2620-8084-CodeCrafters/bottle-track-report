digraph G {
  graph [rankdir=TB, bgcolor="white", fontname="Inter", nodesep=0.45, ranksep=0.55, pad=0.3, newrank=true];
  node [fontname="Inter", fontsize=12, color="#78716c"];
  edge [fontname="Inter", fontsize=11, arrowsize=0.8];
  start [shape=circle, style=filled, fillcolor="#1f2937", fontcolor="white", label="Inicio", width=0.8, fixedsize=true];
  dash [shape=plain, label=<<TABLE BORDER="2" COLOR="#f97316" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD FIXEDSIZE="TRUE" WIDTH="224" HEIGHT="140"><IMG SRC="screens/supervisor-dashboard.png" SCALE="TRUE"/></TD></TR><TR><TD BGCOLOR="#fff7ed"><B>Dashboard del supervisor</B></TD></TR></TABLE>>];
  a1 [shape=box, style="rounded,filled", fillcolor="#f5f5f4", color="#a8a29e", label=<Selecciona «Perfil» en<BR/>el menú>];
  prof [shape=plain, label=<<TABLE BORDER="2" COLOR="#f97316" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD FIXEDSIZE="TRUE" WIDTH="224" HEIGHT="140"><IMG SRC="screens/profile.png" SCALE="TRUE"/></TD></TR><TR><TD BGCOLOR="#fff7ed"><B>Perfil</B></TD></TR></TABLE>>];
  d1 [shape=diamond, style=filled, fillcolor="#fef3c7", color="#d97706", penwidth=1.5, margin="0.02,0.02", label=<¿Qué acción elige?>];
  a2 [shape=box, style="rounded,filled", fillcolor="#f5f5f4", color="#a8a29e", label=<Edita nombres y correo y<BR/>guarda>];
  d2 [shape=diamond, style=filled, fillcolor="#fef3c7", color="#d97706", penwidth=1.5, margin="0.02,0.02", label=<¿El correo ya está<BR/>registrado?>];
  e2 [shape=box, style="rounded,filled", fillcolor="#fee2e2", color="#dc2626", penwidth=1.5, label=<<B>Unhappy path</B><BR/>Mensaje «El correo ya está<BR/>registrado»; no se guardan<BR/>los cambios>];
  end1 [shape=box, style="rounded,filled,bold", fillcolor="#dcfce7", color="#15803d", penwidth=2, label=<<B>Fin</B><BR/>El perfil muestra los<BR/>datos actualizados>];
  login [shape=plain, label=<<TABLE BORDER="2" COLOR="#f97316" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD FIXEDSIZE="TRUE" WIDTH="224" HEIGHT="140"><IMG SRC="screens/sign-in.png" SCALE="TRUE"/></TD></TR><TR><TD BGCOLOR="#fff7ed"><B>Inicio de sesión</B></TD></TR></TABLE>>];
  d3 [shape=diamond, style=filled, fillcolor="#fef3c7", color="#d97706", penwidth=1.5, margin="0.02,0.02", label=<¿Intenta volver<BR/>con «Atrás»?>];
  e3 [shape=box, style="rounded,filled", fillcolor="#fee2e2", color="#dc2626", penwidth=1.5, label=<<B>Unhappy path</B><BR/>La ruta está protegida:<BR/>vuelve al inicio de sesión>];
  end2 [shape=box, style="rounded,filled,bold", fillcolor="#dcfce7", color="#15803d", penwidth=2, label=<<B>Fin</B><BR/>Sesión cerrada de forma<BR/>segura>];
  start -> dash [color="#15803d", fontcolor="#15803d", penwidth=2.2];
  dash -> a1 [color="#15803d", fontcolor="#15803d", penwidth=2.2];
  a1 -> prof [color="#15803d", fontcolor="#15803d", penwidth=2.2];
  prof -> d1 [color="#15803d", fontcolor="#15803d", penwidth=2.2];
  d1 -> a2 [color="#15803d", fontcolor="#15803d", penwidth=2.2, label=<<B>Editar datos</B>>];
  a2 -> d2 [color="#15803d", fontcolor="#15803d", penwidth=2.2];
  d2 -> end1 [color="#15803d", fontcolor="#15803d", penwidth=2.2, label=<<B>No</B>>];
  d2 -> e2 [color="#dc2626", fontcolor="#dc2626", style=dashed, penwidth=1.6, label=<<B>Sí</B>>];
  e2 -> prof [color="#dc2626", fontcolor="#dc2626", style=dashed, penwidth=1.6, label=<<B>Cambia el correo</B>>, constraint=false];
  d1 -> login [color="#15803d", fontcolor="#15803d", penwidth=2.2, label=<<B>Cerrar sesión</B>>];
  login -> d3 [color="#15803d", fontcolor="#15803d", penwidth=2.2];
  d3 -> end2 [color="#15803d", fontcolor="#15803d", penwidth=2.2, label=<<B>No</B>>];
  d3 -> e3 [color="#dc2626", fontcolor="#dc2626", style=dashed, penwidth=1.6, label=<<B>Sí</B>>];
  e3 -> login [color="#dc2626", fontcolor="#dc2626", style=dashed, penwidth=1.6, constraint=false];
  { rank=same; d2; e2; }
  { rank=same; d3; e3; }
}
