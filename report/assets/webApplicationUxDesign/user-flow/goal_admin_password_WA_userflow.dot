digraph G {
  graph [rankdir=TB, bgcolor="white", fontname="Inter", nodesep=0.45, ranksep=0.55, pad=0.3, newrank=true];
  node [fontname="Inter", fontsize=12, color="#78716c"];
  edge [fontname="Inter", fontsize=11, arrowsize=0.8];
  start [shape=circle, style=filled, fillcolor="#1f2937", fontcolor="white", label="Inicio", width=0.8, fixedsize=true];
  login [shape=plain, label=<<TABLE BORDER="2" COLOR="#f97316" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD FIXEDSIZE="TRUE" WIDTH="224" HEIGHT="140"><IMG SRC="screens/sign-in.png" SCALE="TRUE"/></TD></TR><TR><TD BGCOLOR="#fff7ed"><B>Inicio de sesión</B></TD></TR></TABLE>>];
  a1 [shape=box, style="rounded,filled", fillcolor="#f5f5f4", color="#a8a29e", label=<Presiona «¿Olvidaste tu<BR/>contraseña?»>];
  rec [shape=plain, label=<<TABLE BORDER="2" COLOR="#f97316" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD FIXEDSIZE="TRUE" WIDTH="224" HEIGHT="140"><IMG SRC="screens/password-recovery.png" SCALE="TRUE"/></TD></TR><TR><TD BGCOLOR="#fff7ed"><B>Recuperar contraseña</B></TD></TR></TABLE>>];
  d0 [shape=diamond, style=filled, fillcolor="#fef3c7", color="#d97706", penwidth=1.5, margin="0.02,0.02", label=<¿Envía el enlace o<BR/>vuelve?>];
  x1 [shape=box, style="rounded,filled", fillcolor="#e7e5e4", color="#78716c", label=<<B>Fin alternativo</B><BR/>Regresa al inicio de<BR/>sesión sin enviar el<BR/>enlace>];
  d1 [shape=diamond, style=filled, fillcolor="#fef3c7", color="#d97706", penwidth=1.5, margin="0.02,0.02", label=<¿Correo con<BR/>formato válido?>];
  e1 [shape=box, style="rounded,filled", fillcolor="#fee2e2", color="#dc2626", penwidth=1.5, label=<<B>Unhappy path</B><BR/>El campo se marca como<BR/>inválido y no se envía el<BR/>enlace>];
  a2 [shape=box, style="rounded,filled", fillcolor="#f5f5f4", color="#a8a29e", label=<Se confirma el envío; el<BR/>enlace vence en 30<BR/>minutos>];
  d2 [shape=diamond, style=filled, fillcolor="#fef3c7", color="#d97706", penwidth=1.5, margin="0.02,0.02", label=<¿Recibe el correo<BR/>a tiempo?>];
  e2 [shape=box, style="rounded,filled", fillcolor="#fee2e2", color="#dc2626", penwidth=1.5, label=<<B>Unhappy path</B><BR/>Revisa la carpeta de spam<BR/>o solicita un nuevo enlace>];
  end [shape=box, style="rounded,filled,bold", fillcolor="#dcfce7", color="#15803d", penwidth=2, label=<<B>Fin</B><BR/>Define una nueva<BR/>contraseña e inicia sesión>];
  start -> login [color="#15803d", fontcolor="#15803d", penwidth=2.2];
  login -> a1 [color="#15803d", fontcolor="#15803d", penwidth=2.2];
  a1 -> rec [color="#15803d", fontcolor="#15803d", penwidth=2.2];
  rec -> d0 [color="#15803d", fontcolor="#15803d", penwidth=2.2];
  d0 -> d1 [color="#15803d", fontcolor="#15803d", penwidth=2.2, label=<<B>Enviar enlace</B>>];
  d0 -> x1 [color="#dc2626", fontcolor="#dc2626", style=dashed, penwidth=1.6, label=<<B>Volver</B>>];
  d1 -> a2 [color="#15803d", fontcolor="#15803d", penwidth=2.2, label=<<B>Sí</B>>];
  d1 -> e1 [color="#dc2626", fontcolor="#dc2626", style=dashed, penwidth=1.6, label=<<B>No</B>>];
  e1 -> rec [color="#dc2626", fontcolor="#dc2626", style=dashed, penwidth=1.6, label=<<B>Corrige</B>>, constraint=false];
  a2 -> d2 [color="#15803d", fontcolor="#15803d", penwidth=2.2];
  d2 -> end [color="#15803d", fontcolor="#15803d", penwidth=2.2, label=<<B>Sí</B>>];
  d2 -> e2 [color="#dc2626", fontcolor="#dc2626", style=dashed, penwidth=1.6, label=<<B>No</B>>];
  e2 -> rec [color="#dc2626", fontcolor="#dc2626", style=dashed, penwidth=1.6, label=<<B>Solicita otro</B>>, constraint=false];
  { rank=same; d0; x1; }
  { rank=same; d1; e1; }
  { rank=same; d2; e2; }
}
