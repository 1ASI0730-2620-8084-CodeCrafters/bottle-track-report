@startuml
' BottleTrack - Database diagram (MySQL)
' Reflects AppDbContextModelSnapshot.cs of the Web Services repository (branch develop):
' InitialCreate (Identity and Access Management, Fleet Management), AddIncidentManagement,
' AddOperationsAndRoutes and AddIotMonitoring.
' <<FK>>  foreign key constraint created by the migrations (solid line).
' <<REF>> identifier of another aggregate or bounded context, without a constraint (dashed line).
' Enumerations are stored as VARCHAR with snake_case values.
skinparam dpi 200
hide circle
skinparam linetype ortho
skinparam shadowing false
skinparam defaultFontName Arial
skinparam class {
  BackgroundColor #ffffff
  BorderColor #b34900
  ArrowColor #4f2000
}
skinparam package {
  BackgroundColor #fff7ed
  BorderColor #f97316
}

package "Identity and Access Management" {
  entity organizations {
    * id : CHAR(36) <<PK>>
    --
    * business_name : VARCHAR(150)
    * tax_id : VARCHAR(11) <<UQ>>
    * email : VARCHAR(255)
    * phone : VARCHAR(30)
    * address : VARCHAR(255)
  }
  entity users {
    * id : CHAR(36) <<PK>>
    --
    * organization_id : CHAR(36) <<FK>>
    * first_name : VARCHAR(80)
    * last_name : VARCHAR(80)
    * email : VARCHAR(255) <<UQ>>
    * password_hash : VARCHAR(255)
    * role : VARCHAR(30)
    * status : VARCHAR(20)
  }
}

package "Fleet Management" {
  entity vehicles {
    * id : CHAR(36) <<PK>>
    --
    * organization_id : CHAR(36) <<FK>>
    * plate_number : VARCHAR(7) <<UQ>>
    * brand : VARCHAR(60)
    * model : VARCHAR(60)
    * capacity_in_boxes : INT
    * status : VARCHAR(20)
  }
  entity drivers {
    * id : CHAR(36) <<PK>>
    --
    * organization_id : CHAR(36) <<FK>>
    * first_name : VARCHAR(80)
    * last_name : VARCHAR(80)
    * document_number : VARCHAR(8) <<UQ>>
    * license_number : VARCHAR(9) <<UQ>>
    * phone : VARCHAR(30)
    * status : VARCHAR(20)
  }
}

package "Operations and Routes" {
  entity delivery_points {
    * id : CHAR(36) <<PK>>
    --
    * organization_id : CHAR(36) <<FK>>
    owner_user_id : CHAR(36) <<REF>>
    * business_name : VARCHAR(255)
    * address : VARCHAR(255)
    * district : VARCHAR(100)
    latitude : DECIMAL(9,6)
    longitude : DECIMAL(9,6)
  }
  entity transport_operations {
    * id : CHAR(36) <<PK>>
    --
    * organization_id : CHAR(36) <<FK>>
    * code : VARCHAR(10) <<UQ>>
    * description : VARCHAR(255)
    * scheduled_date : DATETIME(6)
    vehicle_id : CHAR(36) <<REF>>
    driver_id : CHAR(36) <<REF>>
    * status : VARCHAR(20)
    dispatched_at : DATETIME(6)
    completed_at : DATETIME(6)
    cancellation_reason : VARCHAR(255)
  }
  entity delivery_stops {
    * id : CHAR(36) <<PK>>
    --
    * transport_operation_id : CHAR(36) <<FK>>
    * delivery_point_id : CHAR(36) <<FK>>
    * sequence_number : INT
    * planned_quantity : INT
    delivered_quantity : INT
    * status : VARCHAR(20)
    failure_reason : VARCHAR(255)
    confirmed_at : DATETIME(6)
  }
}

package "IoT Monitoring" {
  entity iot_devices {
    * id : CHAR(36) <<PK>>
    --
    * serial_number : VARCHAR(60) <<UQ>>
    vehicle_id : CHAR(36) <<REF>>
    * safe_temperature_min : DECIMAL(5,2)
    * safe_temperature_max : DECIMAL(5,2)
    * impact_threshold : DECIMAL(5,2)
    * status : VARCHAR(20)
  }
  entity sensor_readings {
    * id : CHAR(36) <<PK>>
    --
    * iot_device_id : CHAR(36) <<FK>>
    transport_operation_id : CHAR(36) <<REF>>
    * recorded_at : DATETIME(6)
    latitude : DECIMAL(9,6)
    longitude : DECIMAL(9,6)
    temperature_celsius : DECIMAL(5,2)
    impact_force : DECIMAL(5,2)
  }
  entity alerts {
    * id : CHAR(36) <<PK>>
    --
    * iot_device_id : CHAR(36) <<FK>>
    * transport_operation_id : CHAR(36) <<REF>>
    * type : VARCHAR(30)
    * raised_at : DATETIME(6)
    acknowledged_by : CHAR(36) <<REF>>
    acknowledged_at : DATETIME(6)
  }
}

package "Incident Management" {
  entity incidents {
    * id : CHAR(36) <<PK>>
    --
    * code : VARCHAR(10) <<UQ>>
    * transport_operation_id : CHAR(36) <<REF>>
    delivery_stop_id : CHAR(36) <<REF>>
    * reported_by : CHAR(36) <<REF>>
    * source : VARCHAR(30)
    * type : VARCHAR(30)
    * severity : VARCHAR(20)
    * description : VARCHAR(500)
    affected_quantity : INT
    * status : VARCHAR(20)
    resolution : VARCHAR(500)
    * reported_at : DATETIME(6)
    resolved_at : DATETIME(6)
  }
  entity evidences {
    * id : CHAR(36) <<PK>>
    --
    * incident_id : CHAR(36) <<FK>>
    * file_url : VARCHAR(500)
    * file_type : VARCHAR(30)
    * uploaded_by : CHAR(36) <<REF>>
    * uploaded_at : DATETIME(6)
  }
}

' Foreign key constraints (10)
organizations ||--|{ users
organizations ||--o{ vehicles
organizations ||--o{ drivers
organizations ||--o{ delivery_points
organizations ||--o{ transport_operations
transport_operations ||--|{ delivery_stops
delivery_points ||--o{ delivery_stops
iot_devices ||--o{ sensor_readings
iot_devices ||--o{ alerts
incidents ||--o{ evidences

' Logical references without a constraint
users |o..o{ delivery_points
vehicles |o..o{ transport_operations
drivers |o..o{ transport_operations
vehicles |o..o| iot_devices
transport_operations |o..o{ sensor_readings
transport_operations ||..o{ alerts
users |o..o{ alerts
transport_operations ||..o{ incidents
delivery_stops |o..o{ incidents
users ||..o{ incidents
users ||..o{ evidences

legend right
  <b>Values of the enumerated columns</b>
  users.role: administrator, fleet_supervisor, delivery_point_owner
  users.status: active, inactive
  vehicles.status: available, assigned, in_maintenance
  drivers.status: available, assigned, inactive
  transport_operations.status: pending, dispatched, in_progress, completed, cancelled
  delivery_stops.status: pending, delivered, partially_delivered, not_delivered
  iot_devices.status: active, offline, retired
  alerts.type: temperature_out_of_range, impact_detected, device_offline
  incidents.source: fleet_supervisor, delivery_point, iot_alert
  incidents.type: broken_bottles, damaged_product, shortage, delay
  incidents.severity: low, medium, high, critical
  incidents.status: reported, under_review, resolved, closed
  ---
  Solid line: foreign key constraint. Dashed line: reference without a constraint.
endlegend
@enduml
