digraph G {
  graph [rankdir=TB, bgcolor="white", fontname="Inter", nodesep=0.45, ranksep=0.55, pad=0.3, newrank=true];
  node [fontname="Inter", fontsize=12, color="#78716c"];
  edge [fontname="Inter", fontsize=11, arrowsize=0.8];
  start [shape=circle, style=filled, fillcolor="#1f2937", fontcolor="white", label="Inicio", width=0.8, fixedsize=true];
  dash [shape=plain, label=<<TABLE BORDER="2" COLOR="#f97316" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD FIXEDSIZE="TRUE" WIDTH="224" HEIGHT="140"><IMG SRC="screens/admin-dashboard.png" SCALE="TRUE"/></TD></TR><TR><TD BGCOLOR="#fff7ed"><B>Dashboard del administrador</B></TD></TR></TABLE>>];
  a1 [shape=box, style="rounded,filled", fillcolor="#f5f5f4", color="#a8a29e", label=<Selecciona «Empresa» en<BR/>el menú>];
  cfg [shape=plain, label=<<TABLE BORDER="2" COLOR="#f97316" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD FIXEDSIZE="TRUE" WIDTH="224" HEIGHT="140"><IMG SRC="screens/admin-company.png" SCALE="TRUE"/></TD></TR><TR><TD BGCOLOR="#fff7ed"><B>Configuración de empresa</B></TD></TR></TABLE>>];
  a2 [shape=box, style="rounded,filled", fillcolor="#f5f5f4", color="#a8a29e", label=<Edita razón social,<BR/>teléfono o dirección>];
  d0 [shape=diamond, style=filled, fillcolor="#fef3c7", color="#d97706", penwidth=1.5, margin="0.02,0.02", label=<¿Guarda o cancela?>];
  x1 [shape=box, style="rounded,filled", fillcolor="#e7e5e4", color="#78716c", label=<<B>Fin alternativo</B><BR/>Se descartan los cambios y<BR/>se mantienen los datos<BR/>anteriores>];
  d1 [shape=diamond, style=filled, fillcolor="#fef3c7", color="#d97706", penwidth=1.5, margin="0.02,0.02", label=<¿Campos<BR/>obligatorios<BR/>completos?>];
  e1 [shape=box, style="rounded,filled", fillcolor="#fee2e2", color="#dc2626", penwidth=1.5, label=<<B>Unhappy path</B><BR/>El formulario señala el<BR/>campo vacío y no guarda>];
  d2 [shape=diamond, style=filled, fillcolor="#fef3c7", color="#d97706", penwidth=1.5, margin="0.02,0.02", label=<¿El servicio<BR/>guardó los<BR/>cambios?>];
  e2 [shape=box, style="rounded,filled", fillcolor="#fee2e2", color="#dc2626", penwidth=1.5, label=<<B>Unhappy path</B><BR/>Mensaje «No pudimos<BR/>guardar los cambios.<BR/>Inténtalo de nuevo»>];
  end [shape=box, style="rounded,filled,bold", fillcolor="#dcfce7", color="#15803d", penwidth=2, label=<<B>Fin</B><BR/>Los datos de la empresa se<BR/>muestran actualizados>];
  start -> dash [color="#15803d", fontcolor="#15803d", penwidth=2.2];
  dash -> a1 [color="#15803d", fontcolor="#15803d", penwidth=2.2];
  a1 -> cfg [color="#15803d", fontcolor="#15803d", penwidth=2.2];
  cfg -> a2 [color="#15803d", fontcolor="#15803d", penwidth=2.2];
  a2 -> d0 [color="#15803d", fontcolor="#15803d", penwidth=2.2];
  d0 -> d1 [color="#15803d", fontcolor="#15803d", penwidth=2.2, label=<<B>Guardar cambios</B>>];
  d0 -> x1 [color="#dc2626", fontcolor="#dc2626", style=dashed, penwidth=1.6, label=<<B>Cancelar</B>>];
  d1 -> d2 [color="#15803d", fontcolor="#15803d", penwidth=2.2, label=<<B>Sí</B>>];
  d1 -> e1 [color="#dc2626", fontcolor="#dc2626", style=dashed, penwidth=1.6, label=<<B>No</B>>];
  e1 -> cfg [color="#dc2626", fontcolor="#dc2626", style=dashed, penwidth=1.6, label=<<B>Corrige</B>>, constraint=false];
  d2 -> end [color="#15803d", fontcolor="#15803d", penwidth=2.2, label=<<B>Sí</B>>];
  d2 -> e2 [color="#dc2626", fontcolor="#dc2626", style=dashed, penwidth=1.6, label=<<B>No</B>>];
  e2 -> cfg [color="#dc2626", fontcolor="#dc2626", style=dashed, penwidth=1.6, label=<<B>Reintenta</B>>, constraint=false];
  { rank=same; d0; x1; }
  { rank=same; d1; e1; }
  { rank=same; d2; e2; }
}
